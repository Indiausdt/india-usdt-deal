{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "chmod +x scripts/*.sh && npm run build"
  },
  "deploy": {
    "startCommand": "npx wrangler dev --config dist/server/wrangler.json --ip 0.0.0.0 --port $PORT",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
